# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!.env.test.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# prisma generated client (regenerated via `npm run postinstall` / `prisma generate`)
/src/generated/

# user-uploaded files saved by the local-disk storage adapter (dev only —
# see lib/services/storage.service.ts)
/public/uploads/
# Copiados de node_modules en postinstall (scripts/copiar-modelos.mjs).
/public/vendor/

# playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# Archivos que generan las herramientas de IA (Prisma instala su
# documentación de skills al correr `prisma init`; Next.js reescribe
# AGENTS.md en cada `next dev`). Son documentación de terceros duplicada,
# no código de este proyecto: se quedan en local y fuera del repositorio.
/.agents/
/.claude/
/.windsurf/
/skills-lock.json
/AGENTS.md
/CLAUDE.md
tests/.sesiones/
