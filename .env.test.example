# Configuración para ejecutar las pruebas. Copia este archivo a `.env.test`.
#
# `.env.test` no se versiona. Existe para que las pruebas nunca toquen la
# base de datos de desarrollo: `tests/unit/setup.ts` vacía tablas entre
# casos y se niega a arrancar si DATABASE_URL no apunta a una base cuyo
# nombre termine en `_test`.
#
# Crea la base antes de la primera ejecución:
#   docker exec -it <contenedor> psql -U pacande -c "CREATE DATABASE pacande_test;"

DATABASE_URL="postgresql://pacande:pacande@localhost:5432/pacande_test?schema=public"

# Valores de prueba. No tienen que ser secretos —nada real se firma con
# ellos— pero sí cumplir la validación de `src/lib/env.ts`, que exige al
# menos 32 caracteres.
AUTH_SECRET="test-secret-not-for-production-0000000000000000"
AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
